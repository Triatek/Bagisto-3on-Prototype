# ================================================================
#  BAGISTO MULTI-CHANNEL SYNC — Environment Variables
#  Salin ke .env Bagisto Anda dan isi nilainya
# ================================================================

# ──────────────────────────────────────────────────────────────
#  QUEUE — wajib dijalankan agar sinkronisasi bekerja async
# ──────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
MULTICHANNEL_QUEUE_CONNECTION=database
MULTICHANNEL_QUEUE_NAME=marketplace-sync

# ──────────────────────────────────────────────────────────────
#  AKTIFKAN / NONAKTIFKAN CHANNEL
# ──────────────────────────────────────────────────────────────
MULTICHANNEL_SHOPEE_ENABLED=true
MULTICHANNEL_TIKTOK_ENABLED=true

# ──────────────────────────────────────────────────────────────
#  SHOPEE OPEN PLATFORM
#  1. Daftar di: https://open.shopee.com/
#  2. Buat App → salin Partner ID dan Partner Key
#  3. Set Redirect URI: https://yourdomain.com/shopee/auth/get_access_token
#  4. Autorisasi toko: https://partner.shopeemobile.com/api/v2/shop/auth_partner?...
# ──────────────────────────────────────────────────────────────
SHOPEE_SANDBOX_MODE=true          # Ganti false saat production
SHOPEE_PARTNER_ID=               # Contoh: 1234567
SHOPEE_PARTNER_KEY=              # Contoh: abcdef1234567890abcdef1234567890
SHOPEE_SHOP_ID=                  # Contoh: 987654321

# ──────────────────────────────────────────────────────────────
#  TIKTOK SHOP OPEN API
#  1. Daftar di: https://developers.tiktok.com/
#  2. Create App → pilih TikTok Shop
#  3. Set Redirect URI: https://yourdomain.com/tiktok/seller/authorized
#  4. Autorisasi toko: https://services.tiktokshop.com/open/authorize?service_id=...
# ──────────────────────────────────────────────────────────────
TIKTOK_APP_KEY=                  # App Key dari TikTok Developer
TIKTOK_APP_SECRET=               # App Secret dari TikTok Developer
TIKTOK_SHOP_ID=                  # Shop ID TikTok Anda
TIKTOK_SHOP_CODE=                # Shop Code (opsional)
